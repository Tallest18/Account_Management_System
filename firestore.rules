rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActiveUser(companyId) {
      let u = getUserData();
      return isAuthenticated() && u.companyId == companyId && u.isActive == true;
    }
    function isAdminOrAccountant(companyId) {
      let u = getUserData();
      return isAuthenticated() && u.companyId == companyId && u.role in ['admin','accountant'] && u.isActive == true;
    }
    function isAdmin(companyId) {
      let u = getUserData();
      return isAuthenticated() && u.companyId == companyId && u.role == 'admin' && u.isActive == true;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || getUserData().companyId == resource.data.companyId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin(resource.data.companyId));
      allow delete: if false;
    }
    match /companies/{companyId} {
      allow read: if isActiveUser(companyId);
      allow create: if isAuthenticated();
      allow update: if isAdmin(companyId);
      allow delete: if false;
    }
    match /accounts/{accountId} {
      allow read: if isActiveUser(resource.data.companyId);
      allow create: if isAdminOrAccountant(request.resource.data.companyId);
      allow update: if isAdminOrAccountant(resource.data.companyId);
      allow delete: if false;
    }
    match /journal_entries/{entryId} {
      allow read: if isActiveUser(resource.data.companyId);
      allow create: if isAdminOrAccountant(request.resource.data.companyId);
      allow update: if isAdminOrAccountant(resource.data.companyId);
      allow delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if isActiveUser(resource.data.companyId);
      allow create: if isAdminOrAccountant(request.resource.data.companyId);
      allow update: if isAdminOrAccountant(resource.data.companyId);
      allow delete: if false;
    }
    match /payments/{paymentId} {
      allow read: if isActiveUser(resource.data.companyId);
      allow create: if isAdminOrAccountant(request.resource.data.companyId);
      allow update: if isAdmin(resource.data.companyId);
      allow delete: if false;
    }
    match /contacts/{contactId} {
      allow read: if isActiveUser(resource.data.companyId);
      allow create: if isAdminOrAccountant(request.resource.data.companyId);
      allow update: if isAdminOrAccountant(resource.data.companyId);
      allow delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin(resource.data.companyId);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isAdmin(request.resource.data.companyId);
      allow update: if true;
      allow delete: if false;
    }
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}